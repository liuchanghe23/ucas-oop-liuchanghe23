<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.chaosblade</groupId><artifactId>space-exploration</artifactId><version>1.0.0-SNAPSHOT</version></parent>
  <artifactId>svc-defect-transfer</artifactId>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <testResources>
      <testResource><directory>src/test/resources</directory></testResource>
      <testResource><directory>${project.basedir}/../../templates</directory><includes><include>chaosblade_defect_templates.md</include></includes></testResource>
      <testResource><directory>${project.basedir}/../../examples/defect-transfer</directory><includes><include>*.json</include></includes></testResource>
    </testResources>
    <plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
    <executions><execution><id>repackage</id><goals><goal>repackage</goal></goals><configuration><classifier>boot</classifier></configuration></execution></executions>
  </plugin></plugins></build>
</project>
